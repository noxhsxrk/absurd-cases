 "lines": [
  {
   "id": "town1-l001",
   "key": "l001",
   "text": "ยายฉัน ไม่ได้เห็นดวงอาทิตย์ มาสามสิบปีแล้ว",
   "t0": 0.0,
   "t1": 2.76,
   "dur": 2.76,
   "title": null
  },
  {
   "id": "town1-l002",
   "key": "l002",
   "text": "เพราะในเมืองนี้ ถ้าคุณหาว ดวงอาทิตย์จะตกหนึ่งชั่วโมง",
   "t0": 3.06,
   "t1": 6.54,
   "dur": 3.48,
   "title": null
  },
  {
   "id": "town1-l003",
   "key": "l003",
   "text": "หาวสองที ก็สองชั่วโมง",
   "t0": 7.14,
   "t1": 9.04,
   "dur": 1.9,
   "title": null
  },
  {
   "id": "town1-l004",
   "key": "l004",
   "text": "ที่นี่เลยไม่มีใครกล้าง่วง",
   "t0": 9.49,
   "t1": 11.11,
   "dur": 1.62,
   "title": null
  },
  {
   "id": "town1-l005",
   "key": "l005",
   "text": "เด็กทุกคน ดื่มกาแฟตั้งแต่เกิด",
   "t0": 11.41,
   "t1": 13.45,
   "dur": 2.04,
   "title": null
  },
  {
   "id": "town1-l006",
   "key": "l006",
   "text": "โรงเรียน เรียนคาบละห้านาที",
   "t0": 13.75,
   "t1": 15.82,
   "dur": 2.07,
   "title": null
  },
  {
   "id": "town1-l007",
   "key": "l007",
   "text": "หนังสือเกินสามหน้า ผิดกฎหมาย",
   "t0": 16.12,
   "t1": 18.33,
   "dur": 2.21,
   "title": null
  },
  {
   "id": "town1-l008",
   "key": "l008",
   "text": "ทุกเสาไฟ มีกล้องจับหาว",
   "t0": 18.63,
   "t1": 20.6,
   "dur": 1.97,
   "title": null
  },
  {
   "id": "town1-l009",
   "key": "l009",
   "text": "ใครหาว โดนแปะเทปกาวที่ปาก",
   "t0": 20.9,
   "t1": 23.01,
   "dur": 2.11,
   "title": null
  },
  {
   "id": "town1-l010",
   "key": "l010",
   "text": "คำที่ห้ามพูดที่สุดในเมือง คือ \"น่าเบื่อ\"",
   "t0": 23.31,
   "t1": 25.91,
   "dur": 2.6,
   "title": null
  },
  {
   "id": "town1-l011",
   "key": "l011",
   "text": "ยายฉัน อยู่แต่ในห้อง ปิดม่านทึบสามชั้น",
   "t0": 26.81,
   "t1": 29.41,
   "dur": 2.6,
   "title": null
  },
  {
   "id": "town1-l012",
   "key": "l012",
   "text": "บนผนัง มีรูปยายตอนสาว ถือโทรโข่ง",
   "t0": 29.71,
   "t1": 32.57,
   "dur": 2.86,
   "title": null
  },
  {
   "id": "town1-l013",
   "key": "l013",
   "text": "ทุกคนบอกว่า ยายเคยทำผิด เรื่องเดียว",
   "t0": 32.87,
   "t1": 35.42,
   "dur": 2.55,
   "title": null
  },
  {
   "id": "town1-l014",
   "key": "l014",
   "text": "ไม่มีใครบอกว่า เรื่องอะไร",
   "t0": 35.72,
   "t1": 36.95,
   "dur": 1.23,
   "title": null
  },
  {
   "id": "town1-l015",
   "key": "l015",
   "text": "แล้ววันหนึ่ง เมืองนี้ได้หัวหน้าคนใหม่",
   "t0": 37.95,
   "t1": 40.08,
   "dur": 2.13,
   "title": null
  },
  {
   "id": "town1-l016",
   "key": "l016",
   "text": "เขาจะพรีเซนต์วิสัยทัศน์ ถ่ายทอดสดทุกบ้าน",
   "t0": 40.38,
   "t1": 42.82,
   "dur": 2.44,
   "title": null
  },
  {
   "id": "town1-l017",
   "key": "l017",
   "text": "สไลด์ทั้งหมด สามร้อยแผ่น",
   "t0": 43.12,
   "t1": 44.9,
   "dur": 1.78,
   "title": null
  },
  {
   "id": "town1-l018",
   "key": "l018",
   "text": "ทั้งเมือง ปรบมือ",
   "t0": 45.2,
   "t1": 46.26,
   "dur": 1.06,
   "title": null
  },
  {
   "id": "town1-l019",
   "key": "l019",
   "text": "มีฉันคนเดียว ที่นั่งนับสไลด์",
   "t0": 46.56,
   "t1": 48.51,
   "dur": 1.95,
   "title": null
  },
  {
   "id": "town1-l020",
   "key": "l020",
   "text": "สไลด์ที่สิบ ลุงข้างบ้านหาว",
   "t0": 48.81,
   "t1": 50.67,
   "dur": 1.86,
   "title": null
  },
  {
   "id": "town1-l021",
   "key": "l021",
   "text": "สไลด์ที่ห้าสิบ หน่วยกันหาว หาวเอง",
   "t0": 51.57,
   "t1": 54.31,
   "dur": 2.74,
   "title": null
  },
  {
   "id": "town1-l022",
   "key": "l022",
   "text": "สไลด์ที่สองร้อย ทั้งเมืองหาวพร้อมกัน",
   "t0": 54.61,
   "t1": 57.27,
   "dur": 2.66,
   "title": null
  },
  {
   "id": "town1-l023",
   "key": "l023",
   "text": "ดวงอาทิตย์ ตกไปสามปี",
   "t0": 58.17,
   "t1": 59.76,
   "dur": 1.59,
   "title": null
  },
  {
   "id": "town1-l024",
   "key": "l024",
   "text": "ไก่ทั้งเมือง ตกงาน",
   "t0": 60.06,
   "t1": 61.27,
   "dur": 1.21,
   "title": null
  },
  {
   "id": "town1-l025",
   "key": "l025",
   "text": "ต้นไม้ หันไปหาเสาไฟ",
   "t0": 61.57,
   "t1": 63.15,
   "dur": 1.58,
   "title": null
  },
  {
   "id": "town1-l026",
   "key": "l026",
   "text": "เด็กรุ่นใหม่ วาดดวงอาทิตย์ เป็นหลอดไฟ",
   "t0": 63.45,
   "t1": 65.7,
   "dur": 2.25,
   "title": null
  },
  {
   "id": "town1-l027",
   "key": "l027",
   "text": "และหัวหน้า ยังพรีเซนต์อยู่",
   "t0": 66.0,
   "t1": 67.69,
   "dur": 1.69,
   "title": null
  },
  {
   "id": "town1-l028",
   "key": "l028",
   "text": "คืนนั้น ยายเปิดม่าน ครั้งแรก",
   "t0": 68.79,
   "t1": 70.71,
   "dur": 1.92,
   "title": null
  },
  {
   "id": "town1-l029",
   "key": "l029",
   "text": "ยายบอกว่า หาวทำให้ดวงอาทิตย์ตก",
   "t0": 71.01,
   "t1": 73.42,
   "dur": 2.41,
   "title": null
  },
  {
   "id": "town1-l030",
   "key": "l030",
   "text": "แต่อ้าปากค้าง ทำให้มันขึ้น",
   "t0": 73.72,
   "t1": 75.64,
   "dur": 1.92,
   "title": null
  },
  {
   "id": "town1-l031",
   "key": "l031",
   "text": "สามสิบปีก่อน เมืองนี้มืดห้าวัน",
   "t0": 75.94,
   "t1": 78.3,
   "dur": 2.36,
   "title": null
  },
  {
   "id": "town1-l032",
   "key": "l032",
   "text": "ยายเลยพูดคำต้องห้าม ใส่โทรโข่ง",
   "t0": 78.6,
   "t1": 80.55,
   "dur": 1.95,
   "title": null
  },
  {
   "id": "town1-l033",
   "key": "l033",
   "text": "ทั้งเมืองอ้าปากค้าง ฟ้าสว่างทันที",
   "t0": 80.85,
   "t1": 83.32,
   "dur": 2.47,
   "title": null
  },
  {
   "id": "town1-l034",
   "key": "l034",
   "text": "ศาลตัดสิน ห้ามยายเห็นแดด ตลอดชีวิต",
   "t0": 83.62,
   "t1": 86.12,
   "dur": 2.5,
   "title": null
  },
  {
   "id": "town1-l035",
   "key": "l035",
   "text": "ฉันยืมโทรโข่งยาย",
   "t0": 86.82,
   "t1": 88.07,
   "dur": 1.25,
   "title": null
  },
  {
   "id": "town1-l036",
   "key": "l036",
   "text": "ปีนขึ้นไปหน้ากล้อง ถ่ายทอดสด",
   "t0": 88.37,
   "t1": 90.18,
   "dur": 1.81,
   "title": null
  },
  {
   "id": "town1-l037",
   "key": "l037",
   "text": "แล้วพูดว่า \"หัวหน้าครับ น่าเบื่อ\"",
   "t0": 90.48,
   "t1": 92.52,
   "dur": 2.04,
   "title": null
  },
  {
   "id": "town1-l038",
   "key": "l038",
   "text": "ทั้งเมือง อ้าปากค้าง",
   "t0": 93.32,
   "t1": 94.94,
   "dur": 1.62,
   "title": null
  },
  {
   "id": "town1-l039",
   "key": "l039",
   "text": "สามหมื่นคน สามหมื่นชั่วโมง",
   "t0": 95.24,
   "t1": 97.38,
   "dur": 2.14,
   "title": null
  },
  {
   "id": "town1-l040",
   "key": "l040",
   "text": "ดวงอาทิตย์ ไม่ตกอีกเลย สามปีครึ่ง",
   "t0": 97.68,
   "t1": 100.19,
   "dur": 2.51,
   "title": null
  },
  {
   "id": "town1-l041",
   "key": "l041",
   "text": "ไม่มีใครได้นอน",
   "t0": 100.89,
   "t1": 101.76,
   "dur": 0.87,
   "title": null
  },
  {
   "id": "town1-l042",
   "key": "l042",
   "text": "ศาลตัดสินฉัน เหมือนยาย",
   "t0": 102.56,
   "t1": 103.94,
   "dur": 1.38,
   "title": null
  },
  {
   "id": "town1-l043",
   "key": "l043",
   "text": "ตอนนี้ เรานั่งในห้องมืด ด้วยกัน",
   "t0": 104.24,
   "t1": 106.21,
   "dur": 1.97,
   "title": null
  },
  {
   "id": "town1-l044",
   "key": "l044",
   "text": "ยายบอกว่า ไม่ต้องห่วง เดี๋ยวก็มืด",
   "t0": 106.51,
   "t1": 108.74,
   "dur": 2.23,
   "title": null
  },
  {
   "id": "town1-l045",
   "key": "l045",
   "text": "เพราะพรุ่งนี้ หัวหน้าจะพรีเซนต์ ภาคสอง",
   "t0": 109.04,
   "t1": 111.59,
   "dur": 2.55,
   "title": null
  }
 ],

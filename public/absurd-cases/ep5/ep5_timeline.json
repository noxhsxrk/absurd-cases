 "lines": [
  {
   "id": "ep5-l001",
   "key": "l001",
   "text": "ชายคนนี้ กำลังถูสบู่ในห้องน้ำ",
   "t0": 0.0,
   "t1": 2.224,
   "dur": 2.224,
   "title": null
  },
  {
   "id": "ep5-l002",
   "key": "l002",
   "text": "แล้วสบู่ก็หลุดมือ ลงไปดักรอที่พื้น",
   "t0": 2.474,
   "t1": 5.669,
   "dur": 3.195,
   "title": null
  },
  {
   "id": "ep5-l003",
   "key": "l003",
   "text": "นั่นคือการพยายามฆ่า",
   "t0": 5.919,
   "t1": 7.429,
   "dur": 1.51,
   "title": "พยายามฆ่า"
  },
  {
   "id": "ep5-l004",
   "key": "l004",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 7.629,
   "t1": 8.663,
   "dur": 1.034,
   "title": null
  },
  {
   "id": "ep5-l005",
   "key": "l005",
   "text": "หน่วยสวาทสิบห้านาย พังประตูเข้ามา",
   "t0": 8.913,
   "t1": 11.16,
   "dur": 2.247,
   "title": null
  },
  {
   "id": "ep5-l006",
   "key": "l006",
   "text": "ห้านายแรกเหยียบสบู่ ลื่นล้มหัวฟาด",
   "t0": 11.41,
   "t1": 14.36,
   "dur": 2.95,
   "title": null
  },
  {
   "id": "ep5-l007",
   "key": "l007",
   "text": "ที่เหลือต้องคลานเข่า เอาปืนช็อตไฟฟ้าจี้ฟอง",
   "t0": 14.61,
   "t1": 17.79,
   "dur": 3.18,
   "title": null
  },
  {
   "id": "ep5-l008",
   "key": "l008",
   "text": "แล้วใช้คีมกู้ระเบิด คีบใส่กุญแจมือ",
   "t0": 18.04,
   "t1": 20.44,
   "dur": 2.4,
   "title": null
  },
  {
   "id": "ep5-l009",
   "key": "l009",
   "text": "แต่มันลื่นหลุดกุญแจมือ ไปสามรอบ",
   "t0": 20.69,
   "t1": 22.5,
   "dur": 1.81,
   "title": null
  },
  {
   "id": "ep5-l010",
   "key": "l010",
   "text": "ในห้องสอบสวน มันเอาแต่สร้างฟองเงียบๆ",
   "t0": 22.75,
   "t1": 25.149,
   "dur": 2.399,
   "title": null
  },
  {
   "id": "ep5-l011",
   "key": "l011",
   "text": "ศาลสั่งขังห้องสิบแปด แทนยุงที่ย้ายออก",
   "t0": 25.699,
   "t1": 28.714,
   "dur": 3.015,
   "title": null
  },
  {
   "id": "ep5-l012",
   "key": "l012",
   "text": "พัดลมห้องข้างๆ เป่าฟองคลุมทั้งคุก",
   "t0": 28.964,
   "t1": 31.229,
   "dur": 2.265,
   "title": null
  },
  {
   "id": "ep5-l013",
   "key": "l013",
   "text": "ก่อนมันลื่นหลุดซี่กรง หนีไป",
   "t0": 31.679,
   "t1": 34.179,
   "dur": 2.5,
   "title": null
  }
 ],

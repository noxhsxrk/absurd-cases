 "lines": [
  {
   "id": "ep26-l001",
   "key": "l001",
   "text": "ประตูตู้เย็นเปิด ไฟห้องยี่สิบสาม ออกมาได้แล้ว",
   "t0": 0.0,
   "t1": 3.69,
   "dur": 3.69,
   "title": null
  },
  {
   "id": "ep26-l002",
   "key": "l002",
   "text": "ไม่มีแรงโน้มถ่วง ไฟเลยลุกเป็นลูกกลม",
   "t0": 3.99,
   "t1": 6.29,
   "dur": 2.3,
   "title": null
  },
  {
   "id": "ep26-l003",
   "key": "l003",
   "text": "มันลอยไปตามทางเดิน ซี่กรงที่ผ่าน ละลายหมด",
   "t0": 6.59,
   "t1": 10.8,
   "dur": 4.21,
   "title": null
  },
  {
   "id": "ep26-l004",
   "key": "l004",
   "text": "พอถึงห้องสิบแปด โซ่ดวงจันทร์ก็ขาด",
   "t0": 11.3,
   "t1": 14.1,
   "dur": 2.8,
   "title": null
  },
  {
   "id": "ep26-l005",
   "key": "l005",
   "text": "ชายคนนี้ หลุดออกจากวงโคจร",
   "t0": 14.4,
   "t1": 17.08,
   "dur": 2.68,
   "title": null
  },
  {
   "id": "ep26-l006",
   "key": "l006",
   "text": "นั่นคือ ช่วยผู้ต้องขังหลบหนี",
   "t0": 17.58,
   "t1": 19.97,
   "dur": 2.39,
   "title": "ช่วยผู้ต้องขังหลบหนี"
  },
  {
   "id": "ep26-l007",
   "key": "l007",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 20.17,
   "t1": 21.58,
   "dur": 1.41,
   "title": null
  },
  {
   "id": "ep26-l008",
   "key": "l008",
   "text": "ผู้คุมรับสาย คว้าถังดับเพลิง ฉีดใส่ไฟ",
   "t0": 21.88,
   "t1": 24.98,
   "dur": 3.1,
   "title": null
  },
  {
   "id": "ep26-l009",
   "key": "l009",
   "text": "แต่แรงถีบ ส่งผู้คุมพุ่งถอยหลัง",
   "t0": 25.38,
   "t1": 28.48,
   "dur": 3.1,
   "title": null
  },
  {
   "id": "ep26-l010",
   "key": "l010",
   "text": "ทะลุรูห้องยี่สิบสอง ออกนอกคุกไป",
   "t0": 28.68,
   "t1": 31.74,
   "dur": 3.06,
   "title": null
  },
  {
   "id": "ep26-l011",
   "key": "l011",
   "text": "ข้างนอกมีแรงโน้มถ่วง ผู้คุมตกลงพื้น",

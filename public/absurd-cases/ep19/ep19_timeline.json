 "lines": [
  {
   "id": "ep19-l001",
   "key": "l001",
   "text": "ชายคนนี้ เดินสะดุดขาตัวเองหน้าบ้าน",
   "t0": 0.0,
   "t1": 2.49,
   "dur": 2.49,
   "title": null
  },
  {
   "id": "ep19-l002",
   "key": "l002",
   "text": "เขารู้สึกคุ้นๆ เหมือนเคยสะดุดท่านี้เป๊ะ",
   "t0": 2.69,
   "t1": 5.31,
   "dur": 2.62,
   "title": null
  },
  {
   "id": "ep19-l003",
   "key": "l003",
   "text": "อาการนี้เรียกว่า เดจาวู",
   "t0": 5.61,
   "t1": 7.65,
   "dur": 2.04,
   "title": null
  },
  {
   "id": "ep19-l004",
   "key": "l004",
   "text": "มันหลอกเขา ว่าเรื่องนี้เคยเกิดขึ้นแล้ว",
   "t0": 7.85,
   "t1": 10.27,
   "dur": 2.42,
   "title": null
  },
  {
   "id": "ep19-l005",
   "key": "l005",
   "text": "นั่นคือ ฉ้อโกงประชาชน",
   "t0": 10.62,
   "t1": 12.68,
   "dur": 2.06,
   "title": "ฉ้อโกงประชาชน"
  },
  {
   "id": "ep19-l006",
   "key": "l006",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 12.88,
   "t1": 13.97,
   "dur": 1.09,
   "title": null
  },
  {
   "id": "ep19-l007",
   "key": "l007",
   "text": "เดจาวู ลอยหนีออกจากหัวเขา",
   "t0": 14.47,
   "t1": 16.69,
   "dur": 2.22,
   "title": null
  },
  {
   "id": "ep19-l008",
   "key": "l008",
   "text": "มันเหลือบเห็น ชายคนนี้ลืมรูดซิปกางเกง",
   "t0": 16.89,
   "t1": 19.77,
   "dur": 2.88,
   "title": null
  },
  {
   "id": "ep19-l009",
   "key": "l009",
   "text": "มันหยิบมือถือ โทรแจ้งตำรวจสวนทันที",
   "t0": 20.27,
   "t1": 23.07,
   "dur": 2.8,
   "title": null
  },
  {
   "id": "ep19-l010",
   "key": "l010",
   "text": "ข้อหา อนาจารในที่สาธารณะ",
   "t0": 23.32,
   "t1": 25.91,
   "dur": 2.59,
   "title": "อนาจารในที่สาธารณะ"
  },
  {
   "id": "ep19-l011",
   "key": "l011",
   "text": "ตำรวจมาถึง จับทั้งคู่ส่งศาล",
   "t0": 26.26,
   "t1": 28.3,
   "dur": 2.04,
   "title": null
  },
  {
   "id": "ep19-l012",
   "key": "l012",
   "text": "แต่พอขึ้นบัลลังก์ ผู้พิพากษาก็เกิดเดจาวู",
   "t0": 28.55,
   "t1": 31.4,
   "dur": 2.85,
   "title": null
  },
  {
   "id": "ep19-l013",
   "key": "l013",
   "text": "\"คดีนี้ ศาลเคยตัดสินไปแล้ว\"",
   "t0": 32.1,
   "t1": 34.37,
   "dur": 2.27,
   "title": null
  },
  {
   "id": "ep19-l014",
   "key": "l014",
   "text": "ห้ามฟ้องซ้ำ เดจาวูได้ยกฟ้อง",
   "t0": 34.62,
   "t1": 36.93,
   "dur": 2.31,
   "title": null
  },
  {
   "id": "ep19-l015",
   "key": "l015",
   "text": "ส่วนคดีซิป ท่านไม่คุ้นเลย",
   "t0": 37.43,
   "t1": 39.02,
   "dur": 1.59,
   "title": null
  },
  {
   "id": "ep19-l016",
   "key": "l016",
   "text": "ชายคนนี้ โดนจำคุกสิบปีคนเดียว",
   "t0": 39.32,
   "t1": 41.89,
   "dur": 2.57,
   "title": null
  },
  {
   "id": "ep19-l017",
   "key": "l017",
   "text": "ตั้งแต่วันนั้น ศาลยกฟ้องทุกคดี เพราะคุ้นไปหมด",
   "t0": 42.59,
   "t1": 46.0,
   "dur": 3.41,
   "title": null
  }
 ],

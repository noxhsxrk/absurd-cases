 "lines": [
  {
   "id": "ep8-l001",
   "key": "l001",
   "text": "ชายคนนี้ กำลังเดินอยู่หน้าบ้าน",
   "t0": 0.0,
   "t1": 2.07,
   "dur": 2.07,
   "title": null
  },
  {
   "id": "ep8-l002",
   "key": "l002",
   "text": "แล้วเงา ก็แอบเดินตามเขาติดๆ",
   "t0": 2.32,
   "t1": 4.5,
   "dur": 2.18,
   "title": null
  },
  {
   "id": "ep8-l003",
   "key": "l003",
   "text": "นั่นคือการคุกคามสะกดรอยตาม",
   "t0": 4.75,
   "t1": 6.78,
   "dur": 2.03,
   "title": "คุกคามสะกดรอยตาม"
  },
  {
   "id": "ep8-l004",
   "key": "l004",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 7.03,
   "t1": 8.03,
   "dur": 1.0,
   "title": null
  },
  {
   "id": "ep8-l005",
   "key": "l005",
   "text": "หน่วยสวาท เอาไฟสปอตไลต์ยี่สิบดวงส่องล้อม",
   "t0": 8.28,
   "t1": 11.26,
   "dur": 2.98,
   "title": null
  },
  {
   "id": "ep8-l006",
   "key": "l006",
   "text": "ใช้เกรียงแซะเงา ออกจากพื้นถนน",
   "t0": 11.51,
   "t1": 13.54,
   "dur": 2.03,
   "title": null
  },
  {
   "id": "ep8-l007",
   "key": "l007",
   "text": "แล้วพับครึ่ง ใส่กุญแจมือ",
   "t0": 13.79,
   "t1": 15.88,
   "dur": 2.09,
   "title": null
  },
  {
   "id": "ep8-l008",
   "key": "l008",
   "text": "ในห้องสอบสวน พอเปิดโคมไฟส่อง",
   "t0": 16.13,
   "t1": 18.48,
   "dur": 2.35,
   "title": null
  },
  {
   "id": "ep8-l009",
   "key": "l009",
   "text": "มันหดตัวหนีแสง ไม่ยอมให้การ",
   "t0": 18.73,
   "t1": 21.08,
   "dur": 2.35,
   "title": null
  },
  {
   "id": "ep8-l010",
   "key": "l010",
   "text": "ศาลเห็นว่าคุกเต็ม เพราะกลิ่นทุเรียน",

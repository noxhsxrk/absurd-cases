 "lines": [
  {
   "id": "ep18-l001",
   "key": "l001",
   "text": "ชายคนนี้ นั่งดูวันหยุดค่อยๆ หมดไป",
   "t0": 0.0,
   "t1": 3.11,
   "dur": 3.11,
   "title": null
  },
  {
   "id": "ep18-l002",
   "key": "l002",
   "text": "เที่ยงคืน วันจันทร์ก็มาอีกแล้ว",
   "t0": 3.56,
   "t1": 6.1,
   "dur": 2.54,
   "title": null
  },
  {
   "id": "ep18-l003",
   "key": "l003",
   "text": "พางานกองโต กับอีเมลสามร้อยฉบับมาด้วย",
   "t0": 6.3,
   "t1": 9.65,
   "dur": 3.35,
   "title": null
  },
  {
   "id": "ep18-l004",
   "key": "l004",
   "text": "เขาขอดูพาสปอร์ต มันไม่มี",
   "t0": 9.9,
   "t1": 11.88,
   "dur": 1.98,
   "title": null
  },
  {
   "id": "ep18-l005",
   "key": "l005",
   "text": "นั่นคือ ลักลอบเข้าเมือง",
   "t0": 12.23,
   "t1": 14.09,
   "dur": 1.86,
   "title": "ลักลอบเข้าเมือง"
  },
  {
   "id": "ep18-l006",
   "key": "l006",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 14.29,
   "t1": 15.5,
   "dur": 1.21,
   "title": null
  },
  {
   "id": "ep18-l007",
   "key": "l007",
   "text": "วันใหม่ทุกวัน เข้ามาทางเส้นแบ่งเขตวันกลางทะเล",
   "t0": 15.9,
   "t1": 19.23,
   "dur": 3.33,
   "title": null
  },
  {
   "id": "ep18-l008",
   "key": "l008",
   "text": "ตำรวจน้ำร้อยลำ เลยไปตั้งด่านตรงนั้น",
   "t0": 19.43,
   "t1": 22.05,
   "dur": 2.62,
   "title": null
  },
  {
   "id": "ep18-l009",
   "key": "l009",
   "text": "ขึงลวดหนาม ใครข้ามต้องโชว์พาสปอร์ต",
   "t0": 22.25,
   "t1": 25.09,
   "dur": 2.84,
   "title": null
  },
  {
   "id": "ep18-l010",
   "key": "l010",
   "text": "แม้แต่พระอาทิตย์ ก็โดนตรวจ",
   "t0": 25.29,
   "t1": 27.01,
   "dur": 1.72,
   "title": null
  },
  {
   "id": "ep18-l011",
   "key": "l011",
   "text": "พอวันจันทร์มาถึง ก็โดนใส่กุญแจมือ",
   "t0": 27.26,
   "t1": 29.69,
   "dur": 2.43,
   "title": null
  },
  {
   "id": "ep18-l012",
   "key": "l012",
   "text": "ศาลสั่งเนรเทศ ส่งกลับไปเมื่อวาน",
   "t0": 30.49,
   "t1": 33.06,
   "dur": 2.57,
   "title": null
  },
  {
   "id": "ep18-l013",
   "key": "l013",
   "text": "แต่มันกลับมาหานายดาบ ทุกสัปดาห์",
   "t0": 33.61,
   "t1": 35.91,
   "dur": 2.3,
   "title": null
  },
  {
   "id": "ep18-l014",
   "key": "l014",
   "text": "นายดาบกลายเป็นคนเดียวในโลก ที่รอวันจันทร์",
   "t0": 36.16,
   "t1": 38.79,
   "dur": 2.63,
   "title": null
  },
  {
   "id": "ep18-l015",
   "key": "l015",
   "text": "สองคนแต่งงานกัน วันจันทร์ได้สัญชาติ",
   "t0": 39.04,
   "t1": 41.52,
   "dur": 2.48,
   "title": null
  },
  {
   "id": "ep18-l016",
   "key": "l016",
   "text": "ตอนนี้ นายดาบเกลียดวันอังคาร",
   "t0": 41.97,
   "t1": 44.51,
   "dur": 2.54,
   "title": null
  }
 ],

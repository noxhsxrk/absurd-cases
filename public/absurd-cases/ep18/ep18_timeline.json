 "lines": [
  {
   "id": "ep18-l001",
   "key": "l001",
   "text": "ชายคนนี้ ดูวันอาทิตย์หมดไป",
   "t0": 0.0,
   "t1": 2.04,
   "dur": 2.04,
   "title": null
  },
  {
   "id": "ep18-l002",
   "key": "l002",
   "text": "เที่ยงคืน วันจันทร์ก็เข้ามาอีก ไม่มีพาสปอร์ต",
   "t0": 2.24,
   "t1": 5.087,
   "dur": 2.847,
   "title": null
  },
  {
   "id": "ep18-l003",
   "key": "l003",
   "text": "นั่นคือ ลักลอบเข้าเมือง",
   "t0": 5.687,
   "t1": 7.386,
   "dur": 1.699,
   "title": "ลักลอบเข้าเมือง"
  },
  {
   "id": "ep18-l004",
   "key": "l004",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 7.586,
   "t1": 8.514,
   "dur": 0.928,
   "title": null
  },
  {
   "id": "ep18-l005",
   "key": "l005",
   "text": "ตำรวจน้ำร้อยลำ ขึงลวดหนามกลางทะเล",
   "t0": 8.814,
   "t1": 11.395,
   "dur": 2.581,
   "title": null
  },
  {
   "id": "ep18-l006",
   "key": "l006",
   "text": "พระอาทิตย์ขึ้นมา โดนขอดูพาสปอร์ต",
   "t0": 11.595,
   "t1": 13.715,
   "dur": 2.12,
   "title": null
  },
  {
   "id": "ep18-l007",
   "key": "l007",
   "text": "ศาลสั่งเนรเทศ กลับไปเมื่อวาน",
   "t0": 15.015,
   "t1": 16.644,
   "dur": 1.629,
   "title": null
  },
  {
   "id": "ep18-l008",
   "key": "l008",
   "text": "แต่มันกลับมาหานายดาบ ทุกสัปดาห์",
   "t0": 17.144,
   "t1": 19.202,
   "dur": 2.058,
   "title": null
  },
  {
   "id": "ep18-l009",
   "key": "l009",
   "text": "นายดาบกลายเป็นคนเดียวในโลก ที่รอวันจันทร์",
   "t0": 19.502,
   "t1": 21.882,
   "dur": 2.38,
   "title": null
  },
  {
   "id": "ep18-l010",
   "key": "l010",
   "text": "สองคนแต่งงานกัน ได้สัญชาติ",
   "t0": 22.182,

 "lines": [
  {
   "id": "ep25-l001",
   "key": "l001",
   "text": "ดวงจันทร์ดึงเขา ลอดซี่กรงเข้าห้องสิบแปด",
   "t0": 0.0,
   "t1": 3.88,
   "dur": 3.88,
   "title": null
  },
  {
   "id": "ep25-l002",
   "key": "l002",
   "text": "แล้วพาวนรอบโลก ตามปกติของดวงจันทร์",
   "t0": 4.18,
   "t1": 7.87,
   "dur": 3.69,
   "title": null
  },
  {
   "id": "ep25-l003",
   "key": "l003",
   "text": "รอบละสามวินาที ไม่มีหยุด",

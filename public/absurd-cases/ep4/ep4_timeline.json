 "lines": [
  {
   "id": "ep4-l001",
   "key": "l001",
   "text": "ชายคนนี้ เปิดตู้เย็นตอนตีสอง",
   "t0": 0.0,
   "t1": 2.43,
   "dur": 2.43,
   "title": null
  },
  {
   "id": "ep4-l002",
   "key": "l002",
   "text": "ทุเรียนในตู้ พ่นกลิ่นใส่หน้าเขา",
   "t0": 2.68,
   "t1": 5.31,
   "dur": 2.63,
   "title": null
  },
  {
   "id": "ep4-l003",
   "key": "l003",
   "text": "นั่นคือการก่อเหตุเดือดร้อนรำคาญ",
   "t0": 5.56,
   "t1": 8.2,
   "dur": 2.64,
   "title": "ก่อเหตุเดือดร้อนรำคาญ"
  },
  {
   "id": "ep4-l004",
   "key": "l004",
   "text": "เขาเลยโทรแจ้งตำ—",
   "t0": 8.45,
   "t1": 9.33,
   "dur": 0.88,
   "title": null
  },
  {
   "id": "ep4-l005",
   "key": "l005",
   "text": "หน่วยสวาทใส่หน้ากากกันแก๊ส บุกมายี่สิบนาย",
   "t0": 9.65,
   "t1": 13.023,
   "dur": 3.373,
   "title": null
  },
  {
   "id": "ep4-l006",
   "key": "l006",
   "text": "เอาเทปกั้นเขต ล้อมตู้เย็นไว้สามชั้น",
   "t0": 13.273,
   "t1": 15.803,
   "dur": 2.53,
   "title": null
  },
  {
   "id": "ep4-l007",
   "key": "l007",
   "text": "แล้วใส่กุญแจมือ ทีละพู",
   "t0": 16.053,
   "t1": 18.055,
   "dur": 2.002,
   "title": null
  },
  {
   "id": "ep4-l008",
   "key": "l008",
   "text": "ในห้องสอบสวน ตำรวจถามว่า มีอะไรจะพูดไหม",
   "t0": 18.305,
   "t1": 21.802,
   "dur": 3.497,
   "title": null
  },
  {
   "id": "ep4-l009",
   "key": "l009",
   "text": "มันตอบด้วยกลิ่น",
   "t0": 22.352,
   "t1": 23.202,
   "dur": 0.85,
   "title": null
  },
  {
   "id": "ep4-l010",
   "key": "l010",
   "text": "ตำรวจสามนาย หมดสติ",
   "t0": 23.502,
   "t1": 25.252,
   "dur": 1.75,
   "title": null
  },
  {
   "id": "ep4-l011",
   "key": "l011",
   "text": "ศาลสั่งขังห้องยี่สิบ ที่เพิ่งว่าง",
   "t0": 25.502,
   "t1": 27.942,
   "dur": 2.44,
   "title": null
  },
  {
   "id": "ep4-l012",
   "key": "l012",
   "text": "แต่พัดลมห้องข้างๆ ส่ายหน้าเป่ากลิ่น ไปห้องสิบแปด",
   "t0": 28.192,
   "t1": 32.008,
   "dur": 3.816,
   "title": null
  },
  {
   "id": "ep4-l013",
   "key": "l013",
   "text": "ยุงขอย้ายห้อง",
   "t0": 32.458,
   "t1": 33.528,
   "dur": 1.07,
   "title": null
  }
 ],

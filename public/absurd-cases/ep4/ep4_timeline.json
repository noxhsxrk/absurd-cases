 "lines": [
  {
   "id": "ep4-l001",
   "key": "l001",
   "text": "ชายคนนี้ เปิดตู้เย็นตอนตีสอง",
   "t0": 0.0,
   "t1": 2.091,
   "dur": 2.091,
   "title": null
  },
  {
   "id": "ep4-l002",
   "key": "l002",
   "text": "ทุเรียนในตู้ พ่นกลิ่นใส่หน้าเขา",
   "t0": 2.341,
   "t1": 4.445,
   "dur": 2.104,
   "title": null
  },
  {
   "id": "ep4-l003",
   "key": "l003",
   "text": "นั่นคือการก่อเหตุเดือดร้อนรำคาญ",
   "t0": 4.695,
   "t1": 6.705,
   "dur": 2.01,
   "title": "ก่อเหตุเดือดร้อนรำคาญ"
  },
  {
   "id": "ep4-l004",
   "key": "l004",
   "text": "เขาเลยโทรแจ้งตำ—",
   "t0": 6.955,
   "t1": 8.095,
   "dur": 1.14,
   "title": null
  },
  {
   "id": "ep4-l005",
   "key": "l005",
   "text": "หน่วยสวาทใส่หน้ากากกันแก๊ส บุกมายี่สิบนาย",
   "t0": 8.415,
   "t1": 11.165,
   "dur": 2.75,
   "title": null
  },
  {
   "id": "ep4-l006",
   "key": "l006",
   "text": "เอาเทปกั้นเขต ล้อมตู้เย็นไว้สามชั้น",
   "t0": 11.415,
   "t1": 13.905,
   "dur": 2.49,
   "title": null
  },
  {
   "id": "ep4-l007",
   "key": "l007",
   "text": "แล้วใส่กุญแจมือ ทีละพู",
   "t0": 14.155,
   "t1": 15.821,
   "dur": 1.666,
   "title": null
  },
  {
   "id": "ep4-l008",
   "key": "l008",
   "text": "ในห้องสอบสวน ตำรวจถามว่า มีอะไรจะพูดไหม",
   "t0": 16.071,
   "t1": 18.557,
   "dur": 2.486,
   "title": null
  },
  {
   "id": "ep4-l009",
   "key": "l009",
   "text": "มันตอบด้วยกลิ่น",
   "t0": 19.107,
   "t1": 20.097,
   "dur": 0.99,
   "title": null
  },
  {
   "id": "ep4-l010",
   "key": "l010",
   "text": "ตำรวจสามนาย หมดสติ",
   "t0": 20.397,
   "t1": 21.96,
   "dur": 1.563,
   "title": null
  },
  {
   "id": "ep4-l011",
   "key": "l011",
   "text": "ศาลสั่งขังห้องยี่สิบ ที่เพิ่งว่าง",
   "t0": 22.21,
   "t1": 24.371,
   "dur": 2.161,
   "title": null
  },
  {
   "id": "ep4-l012",
   "key": "l012",
   "text": "แต่พัดลมห้องข้างๆ ส่ายหน้าเป่ากลิ่น ไปห้องสิบแปด",
   "t0": 24.621,
   "t1": 27.923,
   "dur": 3.302,
   "title": null
  },
  {
   "id": "ep4-l013",
   "key": "l013",
   "text": "ยุงขอย้ายห้อง",
   "t0": 28.373,
   "t1": 29.403,
   "dur": 1.03,
   "title": null
  }
 ],

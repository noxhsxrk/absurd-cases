 "lines": [
  {
   "id": "ep24-l001",
   "key": "l001",
   "text": "ผู้ต้องขังคนใหม่ คือเงาของเขาเอง",
   "t0": 0.0,
   "t1": 3.02,
   "dur": 3.02,
   "title": null
  },
  {
   "id": "ep24-l002",
   "key": "l002",
   "text": "มันไหลลอดซี่กรง กลับมาติดเท้าเขา",
   "t0": 3.32,
   "t1": 6.81,
   "dur": 3.49,
   "title": null
  },
  {
   "id": "ep24-l003",
   "key": "l003",
   "text": "คืนนั้น โลกห้องสิบแปด เขย่ากำแพงช่วยเขา",
   "t0": 7.01,
   "t1": 10.57,
   "dur": 3.56,
   "title": null
  },
  {
   "id": "ep24-l004",
   "key": "l004",
   "text": "แผ่นดินไหวทั้งแดน กำแพงพังจริง",
   "t0": 10.97,
   "t1": 13.82,
   "dur": 2.85,
   "title": null
  },
  {
   "id": "ep24-l005",
   "key": "l005",
   "text": "แต่พังผิดห้อง เป็นห้องยี่สิบสอง",
   "t0": 14.32,
   "t1": 17.21,
   "dur": 2.89,
   "title": null
  },
  {
   "id": "ep24-l006",
   "key": "l006",
   "text": "แรงโน้มถ่วง เลยหลุดออกมา",
   "t0": 17.41,
   "t1": 19.97,
   "dur": 2.56,
   "title": null
  },
  {
   "id": "ep24-l007",
   "key": "l007",
   "text": "ทุกอย่างในแดน ลอยขึ้น",
   "t0": 20.47,
   "t1": 23.71,
   "dur": 3.24,
   "title": null
  },
  {
   "id": "ep24-l008",
   "key": "l008",
   "text": "ชายคนนี้ หลุดจากหน้าต่าง ลอยไปติดเพดาน",
   "t0": 24.01,
   "t1": 27.65,
   "dur": 3.64,
   "title": null
  },
  {
   "id": "ep24-l009",
   "key": "l009",
   "text": "นั่นคือ ละเว้นการปฏิบัติหน้าที่",
   "t0": 27.85,
   "t1": 30.51,
   "dur": 2.66,
   "title": "ละเว้นการปฏิบัติหน้าที่"
  },
  {
   "id": "ep24-l010",
   "key": "l010",
   "text": "เขาจะโทรแจ้งตำรวจ แต่มือถือลอยหนีไปก่อน",
   "t0": 30.71,
   "t1": 33.32,
   "dur": 2.61,
   "title": null
  },
  {
   "id": "ep24-l011",
   "key": "l011",
   "text": "ผู้คุมลอยมาจับแรงโน้มถ่วง ได้แต่อากาศ",
   "t0": 33.62,
   "t1": 37.03,
   "dur": 3.41,
   "title": null
  },
  {
   "id": "ep24-l012",
   "key": "l012",
   "text": "ทั้งแดนลอยหมด เหลือแค่เงาเขา ที่ยังติดพื้น",
   "t0": 37.53,
   "t1": 41.6,
   "dur": 4.07,
   "title": null
  },
  {
   "id": "ep24-l013",
   "key": "l013",
   "text": "แล้วดวงจันทร์ห้องสิบแปด ก็เริ่มดึงเขาเข้าไป",
   "t0": 42.3,
   "t1": 46.22,
   "dur": 3.92,
   "title": null
  }
 ],

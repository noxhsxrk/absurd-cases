 "lines": [
  {
   "id": "ep24-l001",
   "key": "l001",
   "text": "ผู้ต้องขังคนใหม่ คือเงาของเขาเอง",
   "t0": 0.0,
   "t1": 2.81,
   "dur": 2.81,
   "title": null
  },
  {
   "id": "ep24-l002",
   "key": "l002",
   "text": "มันไหลลอดซี่กรง กลับมาติดเท้าเขา",
   "t0": 3.11,
   "t1": 6.62,
   "dur": 3.51,
   "title": null
  },
  {
   "id": "ep24-l003",
   "key": "l003",
   "text": "คืนนั้น โลกห้องสิบแปด เขย่ากำแพงช่วยเขา",
   "t0": 6.82,
   "t1": 10.33,
   "dur": 3.51,
   "title": null
  },
  {
   "id": "ep24-l004",
   "key": "l004",
   "text": "แผ่นดินไหวทั้งแดน กำแพงพังจริง",
   "t0": 10.73,
   "t1": 13.56,
   "dur": 2.83,
   "title": null
  },
  {
   "id": "ep24-l005",
   "key": "l005",
   "text": "แต่พังผิดห้อง เป็นห้องยี่สิบสอง",
   "t0": 14.06,
   "t1": 16.94,
   "dur": 2.88,
   "title": null
  },
  {
   "id": "ep24-l006",
   "key": "l006",
   "text": "แรงโน้มถ่วง เลยหลุดออกมา",
   "t0": 17.14,
   "t1": 19.68,
   "dur": 2.54,
   "title": null
  },
  {
   "id": "ep24-l007",
   "key": "l007",
   "text": "ทุกอย่างในแดน ลอยขึ้น",
   "t0": 20.18,
   "t1": 23.41,
   "dur": 3.23,
   "title": null
  },
  {
   "id": "ep24-l008",
   "key": "l008",
   "text": "ชายคนนี้ หลุดจากหน้าต่าง ลอยไปติดเพดาน",
   "t0": 23.71,
   "t1": 27.18,
   "dur": 3.47,
   "title": null
  },
  {
   "id": "ep24-l009",
   "key": "l009",
   "text": "นั่นคือ ละเว้นการปฏิบัติหน้าที่",
   "t0": 27.38,
   "t1": 30.01,
   "dur": 2.63,
   "title": "ละเว้นการปฏิบัติหน้าที่"
  },
  {
   "id": "ep24-l010",
   "key": "l010",
   "text": "เขาจะโทรแจ้งตำรวจ แต่มือถือลอยหนีไปก่อน",
   "t0": 30.21,
   "t1": 32.82,
   "dur": 2.61,
   "title": null
  },
  {
   "id": "ep24-l011",
   "key": "l011",
   "text": "ผู้คุมลอยมาจับแรงโน้มถ่วง ได้แต่อากาศ",
   "t0": 33.12,
   "t1": 36.5,
   "dur": 3.38,
   "title": null
  },
  {
   "id": "ep24-l012",
   "key": "l012",
   "text": "ทั้งแดนลอยหมด เหลือแค่เงาเขา ที่ยังติดพื้น",
   "t0": 37.0,
   "t1": 40.96,
   "dur": 3.96,
   "title": null
  },
  {
   "id": "ep24-l013",
   "key": "l013",
   "text": "แล้วดวงจันทร์ห้องสิบแปด ก็เริ่มดึงเขาเข้าไป",
   "t0": 41.66,
   "t1": 45.7,
   "dur": 4.04,
   "title": null
  }
 ],

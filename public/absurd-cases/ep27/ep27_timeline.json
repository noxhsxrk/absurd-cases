 "lines": [
  {
   "id": "ep27-l001",
   "key": "l001",
   "text": "ไม่มีผู้คุม ไฟเลยเผาซี่กรงที่เหลือ",
   "t0": 0.0,
   "t1": 3.22,
   "dur": 3.22,
   "title": null
  },
  {
   "id": "ep27-l002",
   "key": "l002",
   "text": "ทั้งแก๊งลอยออกมา ไปรวมกันที่รูห้องยี่สิบสอง",
   "t0": 3.52,
   "t1": 7.86,
   "dur": 4.34,
   "title": null
  },
  {
   "id": "ep27-l003",
   "key": "l003",
   "text": "ชายคนนี้นับดู ครบห้าพอดี",
   "t0": 8.16,
   "t1": 10.82,
   "dur": 2.66,
   "title": null
  },
  {
   "id": "ep27-l004",
   "key": "l004",
   "text": "นั่นคือ ซ่องโจร",
   "t0": 11.32,
   "t1": 12.58,
   "dur": 1.26,
   "title": "ซ่องโจร"
  },
  {
   "id": "ep27-l005",
   "key": "l005",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 12.78,
   "t1": 14.74,
   "dur": 1.96,
   "title": null
  },
  {
   "id": "ep27-l006",
   "key": "l006",
   "text": "มือถือผู้คุม ดังอยู่ข้างนอก",
   "t0": 15.14,
   "t1": 17.52,
   "dur": 2.38,
   "title": null
  },
  {
   "id": "ep27-l007",
   "key": "l007",
   "text": "แต่ผู้คุม โดนใส่กุญแจมืออยู่ รับไม่ได้",
   "t0": 17.82,
   "t1": 21.46,
   "dur": 3.64,
   "title": null
  },
  {
   "id": "ep27-l008",
   "key": "l008",
   "text": "ไม่มีใครมา ทั้งแก๊งเลยลอยออกทางรู",
   "t0": 21.96,
   "t1": 25.18,
   "dur": 3.22,
   "title": null
  },
  {
   "id": "ep27-l009",
   "key": "l009",
   "text": "แรงโน้มถ่วงข้างนอก ดึงลงพื้นทีละตัว",
   "t0": 25.48,
   "t1": 28.98,
   "dur": 3.5,
   "title": null
  },
  {
   "id": "ep27-l010",
   "key": "l010",
   "text": "ชายคนนี้ แหกคุกสำเร็จ",
   "t0": 29.48,
   "t1": 31.58,
   "dur": 2.1,
   "title": null
  },
  {
   "id": "ep27-l011",
   "key": "l011",
   "text": "แต่ลืมเงาไว้ ห้องยี่สิบสี่",
   "t0": 32.08,
   "t1": 34.46,
   "dur": 2.38,
   "title": null
  },
  {
   "id": "ep27-l012",
   "key": "l012",
   "text": "คืนนั้น เงาในห้องยี่สิบสี่ เริ่มไหลไปที่ซี่กรง",
   "t0": 35.26,
   "t1": 39.46,
   "dur": 4.2,
   "title": null
  }
 ],

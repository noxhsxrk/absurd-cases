 "lines": [
  {
   "id": "ep27-l001",
   "key": "l001",
   "text": "ไม่มีผู้คุม ไฟเลยเผาซี่กรงที่เหลือ",
   "t0": 0.0,
   "t1": 2.92,
   "dur": 2.92,
   "title": null
  },
  {
   "id": "ep27-l002",
   "key": "l002",
   "text": "ทั้งแก๊งลอยออกมา ไปรวมกันที่รูห้องยี่สิบสอง",
   "t0": 3.22,
   "t1": 6.56,
   "dur": 3.34,
   "title": null
  },
  {
   "id": "ep27-l003",
   "key": "l003",
   "text": "ชายคนนี้นับดู ครบห้าพอดี",
   "t0": 6.86,
   "t1": 9.79,
   "dur": 2.93,
   "title": null
  },
  {
   "id": "ep27-l004",
   "key": "l004",
   "text": "นั่นคือ ซ่องโจร",
   "t0": 10.29,
   "t1": 12.08,
   "dur": 1.79,
   "title": "ซ่องโจร"
  },
  {
   "id": "ep27-l005",
   "key": "l005",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 12.28,
   "t1": 13.45,
   "dur": 1.17,
   "title": null
  },
  {
   "id": "ep27-l006",
   "key": "l006",
   "text": "มือถือผู้คุม ดังอยู่ข้างนอก",
   "t0": 13.85,
   "t1": 16.21,
   "dur": 2.36,
   "title": null
  },
  {
   "id": "ep27-l007",
   "key": "l007",
   "text": "แต่ผู้คุม โดนใส่กุญแจมืออยู่ รับไม่ได้",
   "t0": 16.51,
   "t1": 19.39,
   "dur": 2.88,
   "title": null
  },
  {
   "id": "ep27-l008",
   "key": "l008",
   "text": "ไม่มีใครมา ทั้งแก๊งเลยลอยออกทางรู",
   "t0": 19.89,
   "t1": 22.8,
   "dur": 2.91,
   "title": null
  },
  {
   "id": "ep27-l009",
   "key": "l009",
   "text": "แรงโน้มถ่วงข้างนอก ดึงลงพื้นทีละตัว",
   "t0": 23.1,
   "t1": 26.39,
   "dur": 3.29,
   "title": null
  },
  {
   "id": "ep27-l010",
   "key": "l010",
   "text": "ชายคนนี้ แหกคุกสำเร็จ",
   "t0": 26.89,
   "t1": 28.94,
   "dur": 2.05,
   "title": null
  },
  {
   "id": "ep27-l011",
   "key": "l011",
   "text": "แต่ลืมเงาไว้ ห้องยี่สิบสี่",
   "t0": 29.44,
   "t1": 31.7,
   "dur": 2.26,
   "title": null
  },
  {
   "id": "ep27-l012",
   "key": "l012",
   "text": "คืนนั้น เงาในห้องยี่สิบสี่ เริ่มไหลไปที่ซี่กรง",
   "t0": 32.5,
   "t1": 36.43,
   "dur": 3.93,
   "title": null
  }
 ],

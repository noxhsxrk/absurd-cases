 "lines": [
  {
   "id": "ep23-l001",
   "key": "l001",
   "text": "ชายคนนี้ ยังติดหน้าต่างครึ่งตัว",
   "t0": 0.0,
   "t1": 2.67,
   "dur": 2.67,
   "title": null
  },
  {
   "id": "ep23-l002",
   "key": "l002",
   "text": "กลิ่นห้องยี่สิบ คือแผนรมผู้คุม",
   "t0": 2.87,
   "t1": 5.26,
   "dur": 2.39,
   "title": null
  },
  {
   "id": "ep23-l003",
   "key": "l003",
   "text": "เช้านั้น ทุเรียนปล่อยกลิ่นเต็มที่",
   "t0": 5.56,
   "t1": 8.43,
   "dur": 2.87,
   "title": null
  },
  {
   "id": "ep23-l004",
   "key": "l004",
   "text": "แต่พัดลมห้องสิบเก้า ส่ายหน้าตามปกติ",
   "t0": 8.93,
   "t1": 11.73,
   "dur": 2.8,
   "title": null
  },
  {
   "id": "ep23-l005",
   "key": "l005",
   "text": "เป่ากลิ่นทั้งหมด เข้าห้องยี่สิบสี่",
   "t0": 11.93,
   "t1": 14.11,
   "dur": 2.18,
   "title": null
  },
  {
   "id": "ep23-l006",
   "key": "l006",
   "text": "นั่นคือ ใช้อาวุธเคมี",
   "t0": 14.71,
   "t1": 16.68,
   "dur": 1.97,
   "title": "ใช้อาวุธเคมี"
  },
  {
   "id": "ep23-l007",
   "key": "l007",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 16.88,
   "t1": 18.04,
   "dur": 1.16,
   "title": null
  },
  {
   "id": "ep23-l008",
   "key": "l008",
   "text": "ผู้คุมใส่หน้ากากกันแก๊ส เดินฝ่าเข้ามา",
   "t0": 18.54,
   "t1": 22.17,
   "dur": 3.63,
   "title": null
  },
  {
   "id": "ep23-l009",
   "key": "l009",
   "text": "จับพัดลม ใส่กุญแจมืออีกคู่",
   "t0": 22.47,
   "t1": 24.53,
   "dur": 2.06,
   "title": null
  },
  {
   "id": "ep23-l010",
   "key": "l010",
   "text": "ห่อพลาสติก ติดป้ายวัตถุอันตราย",
   "t0": 24.73,
   "t1": 27.02,
   "dur": 2.29,
   "title": null
  },
  {
   "id": "ep23-l011",
   "key": "l011",
   "text": "แผนรมผู้คุม รมได้ทุกคน",
   "t0": 27.52,
   "t1": 29.76,
   "dur": 2.24,
   "title": null
  },
  {
   "id": "ep23-l012",
   "key": "l012",
   "text": "ยกเว้นผู้คุม",
   "t0": 30.46,
   "t1": 31.65,
   "dur": 1.19,
   "title": null
  },
  {
   "id": "ep23-l013",
   "key": "l013",
   "text": "ผู้คุมส่องห้องยี่สิบสี่ เห็นแต่ควัน",
   "t0": 32.25,
   "t1": 35.22,
   "dur": 2.97,
   "title": null
  },
  {
   "id": "ep23-l014",
   "key": "l014",
   "text": "เลยประทับตรา หลบหนีแล้ว",
   "t0": 35.42,
   "t1": 37.72,
   "dur": 2.3,
   "title": null
  },
  {
   "id": "ep23-l015",
   "key": "l015",
   "text": "คืนนั้น ผู้ต้องขังคนใหม่ ถูกพาเข้าห้องยี่สิบสี่",
   "t0": 38.72,

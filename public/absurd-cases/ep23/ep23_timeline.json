 "lines": [
  {
   "id": "ep23-l001",
   "key": "l001",
   "text": "ชายคนนี้ ยังติดหน้าต่างครึ่งตัว",
   "t0": 0.0,
   "t1": 2.67,
   "dur": 2.67,
   "title": null
  },
  {
   "id": "ep23-l002",
   "key": "l002",
   "text": "กลิ่นห้องยี่สิบ คือแผนรมผู้คุม",
   "t0": 2.87,
   "t1": 5.31,
   "dur": 2.44,
   "title": null
  },
  {
   "id": "ep23-l003",
   "key": "l003",
   "text": "เช้านั้น ทุเรียนปล่อยกลิ่นเต็มที่",
   "t0": 5.61,
   "t1": 8.48,
   "dur": 2.87,
   "title": null
  },
  {
   "id": "ep23-l004",
   "key": "l004",
   "text": "แต่พัดลมห้องสิบเก้า ส่ายหน้าตามปกติ",
   "t0": 8.98,
   "t1": 11.78,
   "dur": 2.8,
   "title": null
  },
  {
   "id": "ep23-l005",
   "key": "l005",
   "text": "เป่ากลิ่นทั้งหมด เข้าห้องยี่สิบสี่",
   "t0": 11.98,
   "t1": 14.16,
   "dur": 2.18,
   "title": null
  },
  {
   "id": "ep23-l006",
   "key": "l006",
   "text": "นั่นคือ ใช้อาวุธเคมี",
   "t0": 14.76,
   "t1": 16.73,
   "dur": 1.97,
   "title": "ใช้อาวุธเคมี"
  },
  {
   "id": "ep23-l007",
   "key": "l007",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 16.93,
   "t1": 18.05,
   "dur": 1.12,
   "title": null
  },
  {
   "id": "ep23-l008",
   "key": "l008",
   "text": "ผู้คุมใส่หน้ากากกันแก๊ส เดินฝ่าเข้ามา",
   "t0": 18.55,
   "t1": 22.17,
   "dur": 3.62,
   "title": null
  },
  {
   "id": "ep23-l009",
   "key": "l009",
   "text": "จับพัดลม ใส่กุญแจมืออีกคู่",
   "t0": 22.47,
   "t1": 24.52,
   "dur": 2.05,
   "title": null
  },
  {
   "id": "ep23-l010",
   "key": "l010",
   "text": "ห่อพลาสติก ติดป้ายวัตถุอันตราย",
   "t0": 24.72,
   "t1": 27.01,
   "dur": 2.29,
   "title": null
  },
  {
   "id": "ep23-l011",
   "key": "l011",
   "text": "แผนรมผู้คุม รมได้ทุกคน",
   "t0": 27.51,
   "t1": 29.76,
   "dur": 2.25,
   "title": null
  },
  {
   "id": "ep23-l012",
   "key": "l012",
   "text": "ยกเว้นผู้คุม",
   "t0": 30.46,
   "t1": 31.66,
   "dur": 1.2,
   "title": null
  },
  {
   "id": "ep23-l013",
   "key": "l013",
   "text": "ผู้คุมส่องห้องยี่สิบสี่ เห็นแต่ควัน",
   "t0": 32.26,
   "t1": 35.25,
   "dur": 2.99,
   "title": null
  },
  {
   "id": "ep23-l014",
   "key": "l014",
   "text": "เลยประทับตรา หลบหนีแล้ว",
   "t0": 35.45,

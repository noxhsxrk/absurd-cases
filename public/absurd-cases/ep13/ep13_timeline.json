 "lines": [
  {
   "id": "ep13-l001",
   "key": "l001",
   "text": "ชายคนนี้ ตะโกนในห้องว่าง",
   "t0": 0.0,
   "t1": 1.585,
   "dur": 1.585,
   "title": null
  },
  {
   "id": "ep13-l002",
   "key": "l002",
   "text": "เสียงสะท้อน พูดตามเขาทุกคำ",
   "t0": 1.785,
   "t1": 3.385,
   "dur": 1.6,
   "title": null
  },
  {
   "id": "ep13-l003",
   "key": "l003",
   "text": "นั่นคือ ละเมิดลิขสิทธิ์ทางเสียง",
   "t0": 3.585,
   "t1": 5.283,
   "dur": 1.698,
   "title": "ละเมิดลิขสิทธิ์ทางเสียง"
  },
  {
   "id": "ep13-l004",
   "key": "l004",
   "text": "เขาเลย โทรแจ้งตำรวจ",
   "t0": 5.483,
   "t1": 6.694,
   "dur": 1.211,
   "title": null
  },
  {
   "id": "ep13-l005",
   "key": "l005",
   "text": "สายตรวจ มาพูดไกล่เกลี่ยดีๆ",
   "t0": 6.894,
   "t1": 8.816,
   "dur": 1.922,
   "title": null
  },
  {
   "id": "ep13-l006",
   "key": "l006",
   "text": "แต่มันดัน สะท้อนเสียงล้อเลียนตำรวจ",
   "t0": 9.016,
   "t1": 11.043,
   "dur": 2.027,
   "title": null
  },
  {
   "id": "ep13-l007",
   "key": "l007",
   "text": "ตำรวจเลยรุมทุบกำแพง ทลายแหล่งกบดาน",
   "t0": 11.243,
   "t1": 13.999,
   "dur": 2.756,
   "title": null
  },
  {
   "id": "ep13-l008",
   "key": "l008",
   "text": "กวาดคลื่นเสียงใส่โหล ส่งฟ้องศาลทันที",
   "t0": 14.449,
   "t1": 16.683,
   "dur": 2.234,
   "title": null
  },
  {
   "id": "ep13-l009",
   "key": "l009",
   "text": "ศาลสั่งขัง ห้องบุฟองน้ำสิบปี",
   "t0": 16.983,
   "t1": 18.95,
   "dur": 1.967,
   "title": null
  },
  {
   "id": "ep13-l010",
   "key": "l010",
   "text": "ได้ลดโทษ เพราะช่วยซ้อมร้องเพลงให้ผู้คุม",
   "t0": 19.15,
   "t1": 21.289,
   "dur": 2.139,
   "title": null
  },
  {
   "id": "ep13-l011",
   "key": "l011",
   "text": "พ้นโทษมา เสียงแหบจนสะท้อนไม่ไหว",
   "t0": 21.589,
   "t1": 23.86,
   "dur": 2.271,
   "title": null
  },
  {
   "id": "ep13-l012",
   "key": "l012",
   "text": "เลยไปรับจ้าง เป็นซาวด์เอฟเฟกต์ผีหลอก",
   "t0": 24.06,
   "t1": 25.921,
   "dur": 1.861,
   "title": null
  },
  {
   "id": "ep13-l013",
   "key": "l013",
   "text": "อยู่ในบ้านผีสิง จนเกษียณอายุ",
   "t0": 26.221,
   "t1": 27.727,
   "dur": 1.506,
   "title": null
  }
 ],

 "lines": [
  {
   "id": "ep22-l001",
   "key": "l001",
   "text": "ชายคนนี้ ติดซี่กรงครึ่งตัว",
   "t0": 0.0,
   "t1": 2.29,
   "dur": 2.29,
   "title": null
  },
  {
   "id": "ep22-l002",
   "key": "l002",
   "text": "ก้อนสบู่ที่เขาเคยแจ้งจับ มาขอเซ็นสัญญา",
   "t0": 2.59,
   "t1": 5.27,
   "dur": 2.68,
   "title": null
  },
  {
   "id": "ep22-l003",
   "key": "l003",
   "text": "มันถูตัวเขาจนลื่น แล้วดึงสุดแรง",
   "t0": 5.47,
   "t1": 8.24,
   "dur": 2.77,
   "title": null
  },
  {
   "id": "ep22-l004",
   "key": "l004",
   "text": "แต่สบู่ ลื่นหลุดมือ",
   "t0": 8.44,
   "t1": 9.96,
   "dur": 1.52,
   "title": null
  },
  {
   "id": "ep22-l005",
   "key": "l005",
   "text": "เขาดีดกลับเข้าห้อง ไปติดหน้าต่างอีกฝั่ง",
   "t0": 10.61,
   "t1": 13.29,
   "dur": 2.68,
   "title": null
  },
  {
   "id": "ep22-l006",
   "key": "l006",
   "text": "นั่นคือ ทอดทิ้งผู้ซึ่งพึ่งตนเองมิได้",
   "t0": 14.09,
   "t1": 16.9,
   "dur": 2.81,
   "title": "ทอดทิ้งผู้ซึ่งพึ่งตนเองมิได้"
  },
  {
   "id": "ep22-l007",
   "key": "l007",
   "text": "เขาเลยโทรแจ้งตำรวจ",
   "t0": 17.1,
   "t1": 18.26,
   "dur": 1.16,
   "title": null
  },
  {
   "id": "ep22-l008",
   "key": "l008",
   "text": "สายไปติด ตำรวจข้างนอก",
   "t0": 18.46,
   "t1": 20.23,
   "dur": 1.77,
   "title": null
  },
  {
   "id": "ep22-l009",
   "key": "l009",
   "text": "รถสิบคัน ล้อมคุก",
   "t0": 20.58,
   "t1": 22.06,
   "dur": 1.48,
   "title": null
  },
  {
   "id": "ep22-l010",
   "key": "l010",
   "text": "เจอผู้ต้องขัง โผล่ออกมาครึ่งตัว",
   "t0": 22.46,
   "t1": 24.417,
   "dur": 1.957,
   "title": null
  },
  {
   "id": "ep22-l011",
   "key": "l011",
   "text": "นั่นคือ หลบหนีจากที่คุมขัง",
   "t0": 25.067,
   "t1": 27.337,
   "dur": 2.27,
   "title": "หลบหนีจากที่คุมขัง"
  },
  {
   "id": "ep22-l012",
   "key": "l012",
   "text": "จับสบู่ได้ แต่มันลื่นหลุดกุญแจมือ",
   "t0": 27.637,
   "t1": 29.777,
   "dur": 2.14,
   "title": null
  },
  {
   "id": "ep22-l013",
   "key": "l013",
   "text": "ส่วนชายคนนี้ โดนออกหมายจับ",
   "t0": 30.427,
   "t1": 32.357,
   "dur": 1.93,
   "title": null
  },
  {
   "id": "ep22-l014",
   "key": "l014",
   "text": "ทั้งที่ ยังติดคุกอยู่",
   "t0": 32.707,
   "t1": 34.337,
   "dur": 1.63,
   "title": null
  },
  {
   "id": "ep22-l015",
   "key": "l015",
   "text": "คืนนั้น ห้องยี่สิบ เริ่มส่งกลิ่น",
